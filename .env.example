# Required for recommender enrichment and recommendation explanations.
# Any OpenAI-compatible endpoint works. The CS5481 course gateway is:
#   DEEPSEEK_BASE_URL=https://llm.cs.cityu.edu.hk/v1
#   DEEPSEEK_MODEL=CS5351/DeepSeek-V4-Flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# The CS5481 gateway allows ~50 requests/minute per team member (it reports the
# budget in x-ratelimit-team_member-* headers). Bursting past it is slower, not
# faster: a 429 also consumes quota, so the retries starve the real work.
# DEEPSEEK_RPM paces request starts process-wide; 0 disables pacing.
# Measured: RPM=40 gives ~36 enriched items/minute with zero 429s.
DEEPSEEK_RPM=40
DEEPSEEK_MAX_RETRIES=3
# Optional second provider, used only when DEEPSEEK_API_KEY is empty. The card
# page's OPENAI_API_KEY is never reused for recommendations.
# RECOMMENDER_CHAT_API_KEY=
# RECOMMENDER_CHAT_BASE_URL=https://api.openai.com/v1
# RECOMMENDER_CHAT_MODEL=gpt-4.1-mini
# Free local embeddings through Sentence Transformers.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=b28ce2a6fcc9c75ef1c0619575d0ec19af760082
EMBEDDING_LOCAL_PATH=recommender/data/models/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_CACHE_PATH=recommender/data/embeddings-bge-m3
# cpu needs no extra setup. cuda requires a CUDA build of PyTorch, e.g.
#   pip install torch --index-url https://download.pytorch.org/whl/cu124
EMBEDDING_DEVICE=cpu
# GPU example: device=cuda, dtype=float16, batch=4, max sequence length=1024.
EMBEDDING_DTYPE=float32
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_SEQ_LENGTH=8192
# Qdrant. The canonical setup is the docker-compose stack:
#   docker compose up -d qdrant        ->  QDRANT_URL=http://127.0.0.1:6333
# QDRANT_PATH is only read when QDRANT_URL is empty, and then it opens an
# embedded store instead: the two layouts are incompatible (server writes
# collections/ + raft_state.json, embedded writes meta.json + collection/) and
# embedded allows a single process at a time. See CONTRIBUTING.md section 5.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=steam_games
QDRANT_PATH=recommender/data/qdrant
RECOMMENDER_API_URL=http://127.0.0.1:8000
RECOMMENDER_CORS_ORIGINS=http://localhost:3000
# auto: PowerShell network stack on Windows, native fetch elsewhere; direct: force native fetch
STEAM_COMMUNITY_TRANSPORT=auto
