{
  "name": "gamecollectionhelper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:py": "python -m unittest discover -s tests/python",
    "lint:py": "python -m ruff check recommender tests/python",
    "data:stats": "python -m recommender.dataset_stats",
    "check": "npm run typecheck && npm run lint:py && npm test && npm run test:py",
    "recommend:api": "python -m uvicorn recommender.service:app --host 127.0.0.1 --port 8000",
    "recommend:enrich": "python -m recommender.enrich_qdrant",
    "recommend:test": "python -m recommender.smoke_test"
  },
  "dependencies": {
    "next": "15.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
